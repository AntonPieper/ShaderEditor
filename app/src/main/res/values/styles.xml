<resources xmlns:tools="http://schemas.android.com/tools">
	<!-- A fixed near-neutral dark scheme with one accent and one radius.
	ThemeOverlay.ShaderEditor.DeviceAccent changes the accent and its
	container only, so layouts and code read the Material attributes,
	never the se_ colours. -->
	<style name="Theme.ShaderEditor" parent="Theme.Material3.Dark.NoActionBar">
		<item name="background">@android:color/transparent</item>
		<item name="preferenceTheme">@style/PreferenceTheme</item>
		<item name="buttonStyle">@style/ButtonTheme</item>
		<item name="colorPrimary">@color/se_accent</item>
		<item name="colorOnPrimary">@color/se_on_accent</item>
		<item name="colorPrimaryContainer">@color/se_accent_container</item>
		<item name="colorOnPrimaryContainer">@color/se_on_accent_container</item>
		<item name="colorPrimaryInverse">?attr/colorPrimary</item>
		<item name="colorControlActivated">?attr/colorPrimary</item>
		<item name="colorAccent">?attr/colorPrimary</item>
		<item name="colorSecondary">@color/se_on_surface_dim</item>
		<item name="colorOnSecondary">@color/se_surface</item>
		<item name="colorSecondaryContainer">?attr/colorPrimaryContainer</item>
		<item name="colorOnSecondaryContainer">?attr/colorOnPrimaryContainer</item>
		<item name="colorTertiary">@color/se_on_surface_dim</item>
		<item name="colorOnTertiary">@color/se_surface</item>
		<item name="colorTertiaryContainer">@color/se_surface_3</item>
		<item name="colorOnTertiaryContainer">@color/se_on_surface</item>
		<item name="android:colorBackground">@color/se_surface</item>
		<item name="colorOnBackground">@color/se_on_surface</item>
		<item name="colorSurface">@color/se_surface</item>
		<item name="colorSurfaceDim">@color/se_surface</item>
		<item name="colorSurfaceBright">@color/se_surface_3</item>
		<item name="colorSurfaceContainerLowest">@color/se_surface</item>
		<item name="colorSurfaceContainerLow">@color/se_surface_1</item>
		<item name="colorSurfaceContainer">@color/se_surface_1</item>
		<item name="colorSurfaceContainerHigh">@color/se_surface_2</item>
		<item name="colorSurfaceContainerHighest">@color/se_surface_3</item>
		<item name="colorSurfaceVariant">@color/se_surface_3</item>
		<item name="colorSurfaceInverse">@color/se_surface_3</item>
		<item name="android:colorBackgroundFloating">@color/se_surface_2</item>
		<item name="colorOnSurface">@color/se_on_surface</item>
		<item name="colorOnSurfaceVariant">@color/se_on_surface_dim</item>
		<item name="colorOnSurfaceInverse">@color/se_on_surface</item>
		<item name="colorOutline">@color/se_outline</item>
		<item name="colorOutlineVariant">@color/se_line</item>
		<item name="colorError">@color/se_error</item>
		<item name="colorOnError">@color/se_surface</item>
		<!-- What the platform draws for the app, like the text selection
		toolbar, is dark too -->
		<item name="android:isLightTheme" tools:targetApi="q">false</item>
		<!-- Up to 56 dp tall: se_corner; larger and floating: se_corner_container -->
		<item name="shapeCornerSizeExtraSmall">@dimen/se_corner</item>
		<item name="shapeCornerSizeSmall">@dimen/se_corner</item>
		<item name="shapeCornerSizeMedium">@dimen/se_corner</item>
		<item name="shapeCornerSizeLarge">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeLargeIncreased">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeExtraLarge">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeExtraLargeIncreased">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeExtraExtraLarge">@dimen/se_corner_container</item>
		<item name="popupMenuBackground">@drawable/background_popup</item>
		<item name="spinnerStyle">@style/Widget.ShaderEditor.Spinner</item>
		<item name="materialButtonStyle">@style/Widget.ShaderEditor.Button</item>
		<item name="materialButtonTonalStyle">@style/Widget.ShaderEditor.Button.TonalButton</item>
		<item name="materialButtonOutlinedStyle">@style/Widget.ShaderEditor.Button.OutlinedButton</item>
		<item name="borderlessButtonStyle">@style/Widget.ShaderEditor.Button.TextButton</item>
		<item name="materialAlertDialogTheme">@style/ThemeOverlay.ShaderEditor.MaterialAlertDialog</item>
		<item name="alertDialogTheme">@style/ThemeOverlay.ShaderEditor.Dialog.Alert</item>
	</style>

	<!-- Only from Android 12, where the device has colours -->
	<style name="ThemeOverlay.ShaderEditor.DeviceAccent" parent="" />

	<style name="Theme.ShaderEditor.Splash">
		<item name="android:windowBackground">@drawable/background_splash</item>
	</style>

	<style name="Theme.ShaderEditor.Preview">
		<item name="android:windowFullscreen">true</item>
		<item name="android:windowContentOverlay">@null</item>
	</style>

	<!-- The toolbar of a screen without a picture. Its height grows
	with the text; SystemBarMetrics pads it by the status bar. -->
	<style name="Widget.ShaderEditor.Toolbar" parent="Widget.Material3.Toolbar">
		<item name="android:background">@drawable/background_bar</item>
		<item name="android:minHeight">?attr/actionBarSize</item>
		<item name="maxButtonHeight">?attr/actionBarSize</item>
		<item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
		<item name="subtitleTextAppearance">?attr/textAppearanceBodySmall</item>
	</style>

	<!-- The editor's toolbar, over the picture -->
	<style name="Widget.ShaderEditor.Toolbar.OverPicture">
		<item name="android:background">@color/se_level_bar</item>
		<item name="titleTextAppearance">?attr/textAppearanceTitleMedium</item>
	</style>

	<style name="FAB" parent="Widget.Material3.FloatingActionButton.Primary">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_margin">20dp</item>
		<item name="android:layout_alignParentBottom">true</item>
	</style>

	<style name="FABLeft" parent="FAB">
		<item name="android:layout_alignParentStart">true</item>
		<item name="android:layout_alignParentLeft">true</item>
	</style>

	<style name="FABRight" parent="FAB">
		<item name="android:layout_alignParentEnd">true</item>
		<item name="android:layout_alignParentRight">true</item>
	</style>

	<style name="PreferenceTheme" parent="PreferenceThemeOverlay">
		<item name="switchPreferenceCompatStyle">@style/SwitchPreferenceTheme</item>
	</style>

	<style name="SwitchPreferenceTheme" parent="Preference.SwitchPreferenceCompat.Material">
		<item name="widgetLayout">@layout/preference_material_switch</item>
	</style>

	<style name="ButtonTheme" parent="Widget.Material3.Button">
		<item name="iconTint">@color/menu_item_selector</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
	</style>
	<style name="BarButton" parent="Widget.Material3.Button.TextButton">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="android:paddingLeft">12dp</item>
		<item name="android:paddingRight">12dp</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="cornerRadius">@dimen/se_corner</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
		<item name="iconTint">?attr/colorOnSurface</item>
		<item name="android:textColor">?attr/colorOnSurface</item>
		<item name="android:minWidth">@dimen/se_key_height</item>
		<item name="android:minHeight">@dimen/se_key_height</item>
		<item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:gravity">center</item>
		<item name="android:layout_gravity">center</item>
	</style>

	<style name="BarButton.Tab">
		<item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
		<item name="android:paddingLeft">0dp</item>
		<item name="android:paddingRight">0dp</item>
		<item name="android:minHeight">@dimen/extra_key_tab_height</item>
	</style>

	<style name="IconButton" parent="Widget.Material3.Button.UnelevatedButton">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="cornerRadius">999dp</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
		<item name="backgroundTint">@android:color/transparent</item>
		<item name="iconTint">@color/menu_item_selector</item>
	</style>

	<style name="MenuItem" parent="Widget.Material3.Button.TextButton">
		<item name="android:gravity">center|start</item>
		<item name="textAllCaps">false</item>
		<item name="android:textColor">@color/menu_item_selector</item>
		<item name="iconTint">@color/menu_item_selector</item>
		<item name="iconPadding">8dp</item>
		<item name="iconSize">24dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
		<item name="cornerRadius">0dp</item>
	</style>

	<style name="CodeView">
		<item name="android:scrollbars">vertical|horizontal</item>
	</style>

	<!-- A spinner's list floats like a menu -->
	<style name="Widget.ShaderEditor.Spinner" parent="Widget.AppCompat.Spinner">
		<item name="android:popupBackground">@drawable/background_popup</item>
	</style>

	<!-- Buttons are pills by default; here they take the one radius. -->
	<style name="Widget.ShaderEditor.Button" parent="Widget.Material3.Button">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.Icon" parent="Widget.Material3.Button.Icon">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.TonalButton" parent="Widget.Material3.Button.TonalButton">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.TextButton" parent="Widget.Material3.Button.TextButton">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.TextButton.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.TextButton.Dialog.Flush" parent="Widget.Material3.Button.TextButton.Dialog.Flush">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<!-- The library's dialogs that are not built by MaterialAlertDialogBuilder -->
	<style name="ThemeOverlay.ShaderEditor.Dialog.Alert" parent="ThemeOverlay.Material3.Dialog.Alert">
		<item name="android:windowBackground">@drawable/background_dialog</item>
		<item name="buttonBarButtonStyle">@style/Widget.ShaderEditor.Button.TextButton.Dialog.Flush</item>
	</style>

	<style name="ThemeOverlay.ShaderEditor.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
		<item name="buttonBarButtonStyle">@style/Widget.ShaderEditor.Button.TextButton.Dialog</item>
		<item name="buttonBarPositiveButtonStyle">@style/Widget.ShaderEditor.Button.TextButton.Dialog</item>
		<item name="buttonBarNegativeButtonStyle">@style/Widget.ShaderEditor.Button.TextButton.Dialog</item>
		<item name="buttonBarNeutralButtonStyle">@style/Widget.ShaderEditor.Button.TextButton.Dialog.Flush</item>
	</style>
</resources>