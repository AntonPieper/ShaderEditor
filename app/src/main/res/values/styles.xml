<resources>
	<style name="AppTheme" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
		<item name="background">@android:color/transparent</item>
		<item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
		<item name="buttonStyle">@style/ButtonTheme</item>
	</style>

	<style name="SplashTheme" parent="@style/AppTheme">
		<item name="android:windowBackground">@drawable/background_splash</item>
	</style>

	<style name="PreviewTheme" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
		<item name="android:windowFullscreen">true</item>
		<item name="android:windowContentOverlay">@null</item>
	</style>

	<style name="Title" parent="@android:style/TextAppearance.Medium" />

	<style name="Subtitle" parent="@android:style/TextAppearance.Small">
		<item name="android:textSize">12sp</item>
	</style>

	<style name="ListItem" parent="@android:style/TextAppearance.Medium">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textColor">@drawable/drawer_item_selector</item>
	</style>

	<style name="ListItemSecondary" parent="@android:style/TextAppearance.Small">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textColor">@drawable/drawer_item_selector</item>
	</style>

	<style name="FAB" parent="Widget.Material3.FloatingActionButton.Primary">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_margin">20dp</item>
		<item name="android:layout_alignParentBottom">true</item>
	</style>

	<style name="FABLeft" parent="FAB">
		<item name="android:layout_alignParentStart">true</item>
		<item name="android:layout_alignParentLeft">true</item>
	</style>

	<style name="FABRight" parent="FAB">
		<item name="android:layout_alignParentEnd">true</item>
		<item name="android:layout_alignParentRight">true</item>
	</style>

	<style name="ButtonTheme" parent="Widget.Material3.Button">
		<item name="iconTint">@color/menu_item_selector</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
	</style>
	<!-- FilledBarButton == BarButton, because android styles do not support multiple inheritance -->
	<style name="FilledBarButton" parent="Widget.Material3.Button">
		<item name="backgroundTint">@color/primary_translucent</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="cornerRadius">8dp</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
		<item name="iconTint">?attr/actionMenuTextColor</item>
		<item name="android:textColor">@color/menu_item_selector</item>
		<item name="android:minWidth">@dimen/extra_key_width</item>
		<item name="android:minHeight">@dimen/extra_key_height</item>
		<item name="android:textAppearance">?attr/textAppearanceBody1</item>
		<item name="android:layout_marginTop">4dp</item>
		<item name="android:layout_marginBottom">4dp</item>
		<item name="android:gravity">center</item>
		<item name="android:layout_gravity">center</item>
	</style>

	<style name="BarButton" parent="Widget.Material3.Button.TextButton">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="cornerRadius">8dp</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
		<item name="iconTint">@color/menu_item_selector</item>
		<item name="android:textColor">@color/menu_item_selector</item>
		<item name="android:minWidth">@dimen/extra_key_width</item>
		<item name="android:minHeight">@dimen/extra_key_height</item>
		<item name="android:textAppearance">?attr/textAppearanceBody1</item>
		<item name="android:layout_marginTop">4dp</item>
		<item name="android:layout_marginBottom">4dp</item>
		<item name="android:gravity">center</item>
		<item name="android:layout_gravity">center</item>
	</style>

	<style name="IconButton" parent="Widget.Material3.Button.UnelevatedButton">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="cornerRadius">999dp</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
		<item name="backgroundTint">@android:color/transparent</item>
		<item name="iconTint">@color/menu_item_selector</item>
	</style>

	<style name="MenuItem" parent="Widget.Material3.Button.TextButton">
		<item name="android:gravity">center|start</item>
		<item name="textAllCaps">false</item>
		<item name="android:textColor">@color/menu_item_selector</item>
		<item name="iconTint">@color/menu_item_selector</item>
		<item name="iconPadding">8dp</item>
		<item name="iconSize">24dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
		<item name="cornerRadius">0dp</item>
	</style>

	<style name="CodeView">
		<item name="android:scrollbars">vertical|horizontal</item>
	</style>

	<!-- The fixed scheme and the one radius of the project-mode UI, for
	the views it is set on and what they open. -->
	<style name="ThemeOverlay.ShaderEditor" parent="">
		<item name="colorPrimary">@color/se_accent</item>
		<item name="colorOnPrimary">@color/se_on_accent</item>
		<item name="colorControlActivated">@color/se_accent</item>
		<item name="colorPrimaryContainer">@color/se_accent_container</item>
		<item name="colorOnPrimaryContainer">@color/se_on_accent_container</item>
		<item name="colorSecondary">@color/se_on_surface_dim</item>
		<item name="colorSecondaryContainer">@color/se_accent_container</item>
		<item name="colorOnSecondaryContainer">@color/se_on_accent_container</item>
		<item name="colorTertiary">@color/se_on_surface_dim</item>
		<item name="colorTertiaryContainer">@color/se_surface_3</item>
		<item name="colorOnTertiaryContainer">@color/se_on_surface</item>
		<item name="android:colorBackground">@color/se_surface</item>
		<item name="colorSurface">@color/se_surface</item>
		<item name="colorSurfaceContainerLowest">@color/se_surface</item>
		<item name="colorSurfaceContainerLow">@color/se_surface_1</item>
		<item name="colorSurfaceContainer">@color/se_surface_1</item>
		<item name="colorSurfaceContainerHigh">@color/se_surface_2</item>
		<item name="colorSurfaceContainerHighest">@color/se_surface_3</item>
		<item name="colorOnSurface">@color/se_on_surface</item>
		<item name="colorOnSurfaceVariant">@color/se_on_surface_dim</item>
		<item name="colorOutline">@color/se_outline</item>
		<item name="colorOutlineVariant">@color/se_line</item>
		<item name="colorError">@color/se_error</item>
		<!-- Up to 56 dp tall: se_corner; larger and floating: se_corner_container -->
		<item name="shapeCornerSizeExtraSmall">@dimen/se_corner</item>
		<item name="shapeCornerSizeSmall">@dimen/se_corner</item>
		<item name="shapeCornerSizeMedium">@dimen/se_corner</item>
		<item name="shapeCornerSizeLarge">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeLargeIncreased">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeExtraLarge">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeExtraLargeIncreased">@dimen/se_corner_container</item>
		<item name="shapeCornerSizeExtraExtraLarge">@dimen/se_corner_container</item>
		<item name="popupMenuBackground">@drawable/background_popup</item>
	</style>

	<!-- Buttons are pills by default; here they take the one radius. -->
	<style name="Widget.ShaderEditor.Button" parent="Widget.Material3.Button">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.Icon" parent="Widget.Material3.Button.Icon">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>

	<style name="Widget.ShaderEditor.Button.TonalButton" parent="Widget.Material3.Button.TonalButton">
		<item name="shapeAppearance">?attr/shapeAppearanceCornerSmall</item>
	</style>
</resources>