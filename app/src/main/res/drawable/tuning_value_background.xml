<?xml version="1.0" encoding="utf-8"?>
<!-- The outlined field of the tuned value: 1 dp outline, 2 dp in the
	accent while it takes typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_focused="true">
		<shape android:shape="rectangle">
			<corners android:radius="@dimen/se_corner" />
			<stroke android:width="2dp" android:color="?attr/colorPrimary" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<corners android:radius="@dimen/se_corner" />
			<stroke android:width="1dp" android:color="?attr/colorOutline" />
		</shape>
	</item>
</selector>
