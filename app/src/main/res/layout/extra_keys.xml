<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/extra_keys"
	android:layout_width="match_parent"
	android:layout_height="@dimen/se_key_height"
	android:background="@drawable/extra_keys_background"
	android:clickable="true"
	android:focusable="true"
	android:orientation="horizontal"
	android:paddingHorizontal="4dp">

	<Button
		android:id="@+id/insert_tab"
		style="@style/BarButton.Tab"
		android:layout_width="@dimen/se_key_height"
		android:layout_height="@dimen/extra_key_tab_height"
		android:layout_marginEnd="4dp"
		android:layout_weight="0"
		android:contentDescription="@string/insert_tab"
		app:icon="@drawable/ic_keyboard_tab"
		app:iconSize="24dp" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/completions"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_gravity="center"
		android:layout_weight="1"
		android:orientation="horizontal" />

</LinearLayout>