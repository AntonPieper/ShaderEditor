<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/extra_keys"
	android:layout_width="match_parent"
	android:layout_height="@dimen/se_key_height"
	android:background="@drawable/extra_keys_background"
	android:clickable="true"
	android:focusable="true"
	android:orientation="horizontal"
	android:paddingHorizontal="4dp">

	<Button
		android:id="@+id/back_to_file"
		style="@style/BarButton.Back"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="4dp"
		android:layout_weight="0"
		android:visibility="gone"
		app:icon="@drawable/ic_arrow_back"
		app:iconSize="18dp" />

	<Button
		android:id="@+id/insert_tab"
		style="@style/BarButton.Tab"
		android:layout_width="@dimen/se_key_height"
		android:layout_height="@dimen/extra_key_tab_height"
		android:layout_marginEnd="4dp"
		android:layout_weight="0"
		android:contentDescription="@string/insert_tab"
		app:icon="@drawable/ic_keyboard_tab"
		app:iconSize="24dp" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/completions"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_gravity="center"
		android:layout_weight="1"
		android:orientation="horizontal" />

	<!-- The call being written, behind the keys, see ExtraKeysManager;
		it ends at the edge of the screen, in the strip's own padding -->
	<de.markusfisch.android.shadereditor.widget.SignatureView
		android:id="@+id/signature"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_marginEnd="-4dp"
		android:layout_weight="1"
		android:background="?attr/selectableItemBackground"
		android:gravity="center_vertical|end"
		android:paddingEnd="2dp"
		android:textColor="?attr/colorOnSurface"
		android:visibility="gone" />

	<LinearLayout
		android:id="@+id/reference"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:visibility="gone">

		<com.google.android.material.imageview.ShapeableImageView
			android:id="@+id/reference_picture"
			android:layout_width="@dimen/strip_picture"
			android:layout_height="@dimen/strip_picture"
			android:layout_marginStart="8dp"
			android:layout_marginEnd="12dp"
			app:shapeAppearance="?attr/shapeAppearanceCornerSmall" />

		<Button
			android:id="@+id/reference_show"
			style="@style/BarButton.Action"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:text="@string/reference_show" />

		<Button
			android:id="@+id/reference_open"
			style="@style/BarButton.Action"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:text="@string/reference_open" />

	</LinearLayout>

</LinearLayout>