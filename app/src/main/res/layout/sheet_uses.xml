<?xml version="1.0" encoding="utf-8"?>
<!-- Every place a name is written in the folder, by group. -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<com.google.android.material.bottomsheet.BottomSheetDragHandleView
		android:layout_width="match_parent"
		android:layout_height="wrap_content" />

	<TextView
		android:id="@+id/uses_word"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="@dimen/se_margin_sheet"
		android:textAppearance="?attr/textAppearanceTitleLarge" />

	<TextView
		android:id="@+id/uses_count"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="@dimen/se_margin_sheet"
		android:layout_marginTop="4dp"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?attr/colorOnSurfaceVariant" />

	<TextView
		android:id="@+id/uses_note"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="@dimen/se_margin_sheet"
		android:layout_marginTop="4dp"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:visibility="gone" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/uses_list"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:paddingBottom="@dimen/se_margin_sheet" />
</LinearLayout>
