<androidx.appcompat.widget.Toolbar
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/toolbar"
	style="@style/Widget.ShaderEditor.Toolbar.OverPicture"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:theme="@style/ThemeOverlay.Material3.ActionBar"
	app:popupTheme="@style/ThemeOverlay.Material3">

	<Button
		android:id="@+id/menu_btn"
		style="@style/IconButton"
		android:contentDescription="@string/menu_btn"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_gravity="end"
		android:layout_marginEnd="4dp"
		app:icon="@drawable/ic_more_vert"
		app:iconSize="24dp" />

	<Button
		android:id="@+id/toggle_code"
		style="@style/IconButton"
		android:contentDescription="@string/toggle_code"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_gravity="end"
		android:layout_marginEnd="4dp"
		app:icon="@drawable/ic_visibility"
		app:iconSize="24dp" />

	<Button
		android:id="@+id/run_code"
		style="@style/IconButton"
		android:contentDescription="@string/run_code"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_gravity="end"
		android:layout_marginEnd="4dp"
		app:icon="@drawable/ic_play_arrow"
		app:iconSize="24dp" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/show_errors"
		style="@style/IconButton"
		android:contentDescription="@string/show_errors"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_gravity="end"
		android:layout_marginEnd="4dp"
		android:visibility="gone"
		app:icon="@drawable/ic_error"
		app:iconSize="24dp" />

	<Spinner
		android:id="@+id/quality"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="end|center_vertical"
		android:layout_marginEnd="4dp"
		android:background="@null"
		android:padding="0dp" />

	<!-- The title and its second line. The toolbar's own title cannot
	keep the unsaved dot out of its ellipsis; this one has the dot as an
	end drawable, so a long name is shortened before the dot and the
	name never moves when the dot comes or goes. The second line is cut
	in the middle: it keeps the file that runs and the folder's own name
	at the end of a path. -->
	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start|center_vertical"
		android:orientation="vertical">

		<TextView
			android:id="@+id/toolbar_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:drawablePadding="@dimen/se_unsaved_gap"
			android:ellipsize="end"
			android:maxLines="1"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

		<TextView
			android:id="@+id/toolbar_subtitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="middle"
			android:singleLine="true"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:visibility="gone" />
	</LinearLayout>
</androidx.appcompat.widget.Toolbar>
