<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:minHeight="@dimen/se_row_height_two_line"
	android:orientation="horizontal"
	android:paddingHorizontal="@dimen/se_margin_sheet">
	<RadioButton
		android:id="@+id/shader_selected"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@null"
		android:clickable="false"
		android:focusable="false"
		android:importantForAccessibility="no"
		android:minWidth="0dp"
		android:minHeight="0dp" />
	<com.google.android.material.imageview.ShapeableImageView
		android:id="@+id/shader_icon"
		android:layout_width="@dimen/se_thumbnail"
		android:layout_height="@dimen/se_thumbnail"
		android:layout_marginStart="@dimen/se_margin_screen"
		android:importantForAccessibility="no"
		android:scaleType="centerCrop"
		app:shapeAppearance="?attr/shapeAppearanceCornerSmall" />
	<TextView
		android:id="@+id/shader_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/se_margin_screen"
		android:layout_weight="1"
		android:ellipsize="end"
		android:maxLines="1"
		android:textAppearance="?attr/textAppearanceBodyLarge"
		android:textColor="?attr/colorOnSurface" />
</LinearLayout>
