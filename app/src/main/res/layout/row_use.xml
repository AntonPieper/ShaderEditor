<?xml version="1.0" encoding="utf-8"?>
<!-- A place a name is written: its line and the line's code. -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:gravity="center_vertical"
	android:minHeight="@dimen/se_row_height"
	android:orientation="horizontal"
	android:paddingStart="@dimen/se_margin_sheet"
	android:paddingEnd="@dimen/se_margin_screen">

	<TextView
		android:id="@+id/use_line"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="12dp"
		android:fontFeatureSettings="tnum"
		android:gravity="end"
		android:maxLines="1"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?attr/colorOnSurfaceVariant" />

	<TextView
		android:id="@+id/use_code"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:paddingVertical="4dp"
		android:singleLine="true"
		android:textColor="?attr/colorOnSurface"
		android:textSize="14sp" />

	<Button
		android:id="@+id/use_rename"
		style="?attr/borderlessButtonStyle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:text="@string/nav_rename"
		android:visibility="gone" />

	<CheckBox
		android:id="@+id/use_tick"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="8dp"
		android:clickable="false"
		android:focusable="false"
		android:importantForAccessibility="no"
		android:visibility="gone" />
</LinearLayout>
