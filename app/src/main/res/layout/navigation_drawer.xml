<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/navigation_drawer"
	android:layout_width="@dimen/se_drawer_max_width"
	android:layout_height="match_parent"
	android:layout_gravity="start"
	android:background="@drawable/navigation_panel"
	android:clickable="true"
	android:focusable="true"
	android:orientation="vertical">

	<!-- In the toolbar's place and of its height -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="4dp">

		<ImageButton
			android:id="@+id/navigation_up"
			android:layout_width="@dimen/se_tap_target"
			android:layout_height="@dimen/se_tap_target"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/nav_up"
			android:src="@drawable/ic_arrow_upward"
			app:tint="?attr/colorOnSurface" />

		<!-- Without the arrow, the title is in line with the rows -->
		<Space
			android:id="@+id/navigation_up_space"
			android:layout_width="8dp"
			android:layout_height="0dp"
			android:visibility="gone" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical"
			android:paddingStart="4dp">

			<TextView
				android:id="@+id/navigation_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:textColor="?attr/colorOnSurface" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ImageView
					android:id="@+id/navigation_read_only"
					android:layout_width="@dimen/navigation_state_mark"
					android:layout_height="@dimen/navigation_state_mark"
					android:layout_marginEnd="4dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_lock"
					app:tint="?attr/colorOnSurfaceVariant" />

				<TextView
					android:id="@+id/navigation_subtitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:textColor="?attr/colorOnSurfaceVariant" />
			</LinearLayout>
		</LinearLayout>

		<ImageButton
			android:id="@+id/navigation_menu"
			android:layout_width="@dimen/se_tap_target"
			android:layout_height="@dimen/se_tap_target"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/menu_btn"
			android:src="@drawable/ic_more_vert"
			app:tint="?attr/colorOnSurface" />
	</LinearLayout>

	<View
		android:layout_width="match_parent"
		android:layout_height="@dimen/se_hairline"
		android:background="?attr/colorOutlineVariant" />

	<FrameLayout
		android:id="@+id/navigation_lists"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipChildren="true">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/navigation_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:paddingTop="4dp"
			android:paddingBottom="8dp"
			android:scrollbars="vertical" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/navigation_list_next"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:paddingTop="4dp"
			android:paddingBottom="8dp"
			android:scrollbars="vertical"
			android:visibility="gone" />
	</FrameLayout>

	<!-- The hairline on top goes with the bar -->
	<LinearLayout
		android:id="@+id/navigation_bar"
		android:layout_width="match_parent"
		android:layout_height="@dimen/navigation_bar_height"
		android:background="@drawable/navigation_bar"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="@dimen/navigation_bar_padding">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/navigation_new"
			style="@style/Widget.ShaderEditor.Button.Icon"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/nav_new"
			app:icon="@drawable/ic_add" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/navigation_open_file"
			style="@style/Widget.ShaderEditor.Button.TonalButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:text="@string/nav_open_file"
			android:visibility="gone" />
	</LinearLayout>
</LinearLayout>
