<merge xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- ShaderView as the background -->
	<de.markusfisch.android.shadereditor.widget.ShaderView
		android:id="@+id/preview"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<!-- CoordinatorLayout for managing the toolbar, drawer, and content -->
	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/main_coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<!-- LinearLayout to manage vertical space -->
		<LinearLayout
			android:id="@+id/main_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">

			<include layout="@layout/toolbar_main" />

			<!-- What changed outside the app, for the file in the editor;
				made only where shaders are files. -->
			<ViewStub
				android:id="@+id/conflict_bar_stub"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout="@layout/conflict_bar" />

			<!-- DrawerLayout with main content -->
			<de.markusfisch.android.shadereditor.widget.TouchThruDrawerLayout
				android:id="@+id/drawer_layout"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1">

				<!-- Content Frame -->
				<androidx.coordinatorlayout.widget.CoordinatorLayout
					android:id="@+id/content_frame"
					android:layout_width="match_parent"
					android:layout_height="match_parent">

					<!-- In place of the editor while no file is open;
						not a text field, so nothing is typed into
						nowhere. -->
					<TextView
						android:id="@+id/no_file"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:background="?attr/colorSurface"
						android:clickable="true"
						android:focusable="false"
						android:gravity="center"
						android:padding="@dimen/se_margin_screen"
						android:text="@string/no_file_open"
						android:textAppearance="?attr/textAppearanceBodyLarge"
						android:textColor="?attr/colorOnSurfaceVariant"
						android:visibility="gone" />

				</androidx.coordinatorlayout.widget.CoordinatorLayout>

				<!-- Navigation Drawer -->
				<include layout="@layout/drawer" />

			</de.markusfisch.android.shadereditor.widget.TouchThruDrawerLayout>

			<!-- Extra keys row at the bottom -->
			<include
				layout="@layout/extra_keys"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />

		</LinearLayout>

		<!-- Tunes one number of the code while the picture shows -->
		<include layout="@layout/tuning_bar" />

		<!-- The strip behind the navigation bar -->
		<View
			android:id="@+id/navbar"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_gravity="bottom"
			android:background="@color/se_level_bar" />

	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</merge>
