<?xml version="1.0" encoding="utf-8"?>
<!-- An image of a folder: what it looks like, and what can be done
	with it (NAVIGATION 4.4 of the one browser). -->
<androidx.core.widget.NestedScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingBottom="@dimen/se_margin_screen">

		<com.google.android.material.bottomsheet.BottomSheetDragHandleView
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />

		<TextView
			android:id="@+id/image_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="@dimen/se_margin_sheet"
			android:ellipsize="middle"
			android:singleLine="true"
			android:textAppearance="?attr/textAppearanceTitleLarge" />

		<TextView
			android:id="@+id/image_where"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="@dimen/se_margin_sheet"
			android:layout_marginTop="4dp"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="?attr/colorOnSurfaceVariant" />

		<ImageView
			android:id="@+id/image_picture"
			android:layout_width="match_parent"
			android:layout_height="240dp"
			android:layout_marginHorizontal="@dimen/se_margin_sheet"
			android:layout_marginTop="@dimen/se_margin_screen"
			android:importantForAccessibility="no"
			android:scaleType="fitCenter" />

		<TextView
			android:id="@+id/image_info"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="@dimen/se_margin_sheet"
			android:layout_marginTop="12dp"
			android:textAppearance="?attr/textAppearanceBodyLarge" />

		<LinearLayout
			android:id="@+id/image_insert_box"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="@dimen/se_margin_sheet"
			android:layout_marginTop="@dimen/se_margin_screen"
			android:background="@drawable/image_sheet_box"
			android:orientation="vertical"
			android:padding="@dimen/se_margin_screen">

			<TextView
				android:id="@+id/image_insert_says"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorOnSurfaceVariant" />

			<TextView
				android:id="@+id/image_insert_lines"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:fontFamily="@font/jetbrains_mono"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textIsSelectable="true" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/se_margin_screen"
			android:gravity="end"
			android:orientation="horizontal"
			android:paddingHorizontal="16dp">

			<Button
				android:id="@+id/image_rename"
				style="?attr/borderlessButtonStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/nav_rename" />

			<Button
				android:id="@+id/image_delete"
				style="?attr/borderlessButtonStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/nav_delete"
				android:textColor="?attr/colorError" />

			<Button
				android:id="@+id/image_insert"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:text="@string/nav_insert_texture" />
		</LinearLayout>
	</LinearLayout>
</androidx.core.widget.NestedScrollView>
