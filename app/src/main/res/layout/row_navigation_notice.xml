<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_horizontal"
	android:orientation="vertical"
	android:paddingHorizontal="24dp"
	android:paddingTop="48dp"
	android:paddingBottom="24dp">

	<com.google.android.material.progressindicator.CircularProgressIndicator
		android:id="@+id/navigation_notice_progress"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="12dp"
		android:indeterminate="true"
		app:indicatorColor="?attr/colorPrimary" />

	<TextView
		android:id="@+id/navigation_notice_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:textAppearance="?attr/textAppearanceTitleMedium"
		android:textColor="?attr/colorOnSurface" />

	<TextView
		android:id="@+id/navigation_notice_reason"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:gravity="center"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?attr/colorOnSurfaceVariant" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/navigation_notice_action"
		style="@style/Widget.ShaderEditor.Button.TonalButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp" />
</LinearLayout>
