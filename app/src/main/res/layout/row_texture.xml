<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:minHeight="@dimen/se_row_height_two_line"
	android:orientation="horizontal"
	android:paddingHorizontal="@dimen/se_margin_screen"
	android:paddingVertical="@dimen/se_row_padding_vertical">
	<ImageView
		android:id="@+id/texture_preview"
		android:layout_width="@dimen/se_thumbnail"
		android:layout_height="@dimen/se_thumbnail"
		android:layout_marginEnd="@dimen/se_margin_screen"
		android:background="@drawable/picture_placeholder"
		android:contentDescription="@string/texture_preview"
		android:scaleType="centerCrop"/>
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">
		<TextView
			android:id="@+id/texture_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textAppearance="?attr/textAppearanceBodyLarge"
			android:textColor="?attr/colorOnSurface"/>
		<TextView
			android:id="@+id/texture_size"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="?attr/colorOnSurfaceVariant"/>
	</LinearLayout>
</LinearLayout>
