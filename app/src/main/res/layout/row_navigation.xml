<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginEnd="@dimen/navigation_row_margin_end"
	android:background="@drawable/navigation_row"
	android:gravity="center_vertical"
	android:minHeight="@dimen/navigation_row_height_two_lines"
	android:orientation="horizontal"
	android:paddingStart="@dimen/navigation_gutter"
	android:paddingTop="@dimen/navigation_row_padding_vertical"
	android:paddingEnd="@dimen/navigation_row_padding_end"
	android:paddingBottom="@dimen/navigation_row_padding_vertical">

	<ImageView
		android:id="@+id/navigation_picture"
		android:layout_width="@dimen/navigation_picture_size"
		android:layout_height="@dimen/navigation_picture_size"
		android:layout_gravity="top"
		android:layout_marginEnd="@dimen/navigation_picture_margin"
		android:importantForAccessibility="no" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/navigation_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textAppearance="?attr/textAppearanceBodyLarge"
			android:textColor="?attr/colorOnSurface" />

		<TextView
			android:id="@+id/navigation_detail"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="3"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:textColor="?attr/colorOnSurfaceVariant" />
	</LinearLayout>

	<ImageView
		android:id="@+id/navigation_wallpaper"
		android:layout_width="@dimen/navigation_mark_small_size"
		android:layout_height="@dimen/navigation_mark_small_size"
		android:layout_marginStart="@dimen/navigation_mark_spacing"
		android:contentDescription="@string/wallpaper"
		android:src="@drawable/ic_wallpaper"
		android:visibility="gone"
		app:tint="?attr/colorOnSurfaceVariant" />

	<ImageView
		android:id="@+id/navigation_running"
		android:layout_width="@dimen/navigation_mark_size"
		android:layout_height="@dimen/navigation_mark_size"
		android:layout_marginStart="@dimen/navigation_mark_spacing"
		android:contentDescription="@string/nav_running"
		android:src="@drawable/ic_play_arrow"
		android:visibility="gone"
		app:tint="?attr/colorPrimary" />

	<ImageView
		android:id="@+id/navigation_enters"
		android:layout_width="@dimen/navigation_mark_size"
		android:layout_height="@dimen/navigation_mark_size"
		android:layout_marginStart="@dimen/navigation_mark_spacing"
		android:importantForAccessibility="no"
		android:src="@drawable/ic_chevron_right"
		android:visibility="gone"
		app:tint="?attr/colorOutline" />
</LinearLayout>
