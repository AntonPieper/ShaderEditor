<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="@dimen/navigation_row_inset"
	android:background="@drawable/navigation_row"
	android:gravity="center_vertical"
	android:minHeight="@dimen/se_row_height_two_line"
	android:orientation="horizontal"
	android:paddingHorizontal="@dimen/navigation_row_inset"
	android:paddingVertical="@dimen/se_row_padding_vertical">

	<!-- At the top, so that it stays beside the name when the second
	line wraps; centred in a two-line row by its margin -->
	<ImageView
		android:id="@+id/navigation_picture"
		android:layout_width="@dimen/se_thumbnail"
		android:layout_height="@dimen/se_thumbnail"
		android:layout_gravity="top"
		android:layout_marginTop="@dimen/se_row_padding_vertical"
		android:layout_marginEnd="@dimen/se_margin_screen"
		android:importantForAccessibility="no" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/navigation_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textAppearance="?attr/textAppearanceBodyLarge"
			android:textColor="@color/navigation_row_text" />

		<TextView
			android:id="@+id/navigation_detail"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="2"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="@color/navigation_row_mark" />
	</LinearLayout>

	<ImageView
		android:id="@+id/navigation_wallpaper"
		android:layout_width="@dimen/se_mark"
		android:layout_height="@dimen/se_mark"
		android:layout_marginStart="@dimen/navigation_mark_spacing"
		android:contentDescription="@string/wallpaper"
		android:src="@drawable/ic_wallpaper"
		android:visibility="gone"
		app:tint="@color/navigation_row_mark" />

	<ImageView
		android:id="@+id/navigation_read_only_mark"
		android:layout_width="@dimen/navigation_state_mark"
		android:layout_height="@dimen/navigation_state_mark"
		android:layout_marginStart="@dimen/navigation_mark_spacing"
		android:contentDescription="@string/nav_read_only"
		android:src="@drawable/ic_lock"
		android:visibility="gone"
		app:tint="@color/navigation_row_mark" />

	<ImageView
		android:id="@+id/navigation_running"
		android:layout_width="@dimen/navigation_state_mark"
		android:layout_height="@dimen/navigation_state_mark"
		android:layout_marginStart="@dimen/navigation_mark_spacing"
		android:contentDescription="@string/nav_running"
		android:src="@drawable/ic_play_arrow_filled"
		android:visibility="gone"
		app:tint="?attr/colorPrimary" />

	<ImageView
		android:id="@+id/navigation_enters"
		android:layout_width="@dimen/se_icon"
		android:layout_height="@dimen/se_icon"
		android:layout_marginStart="@dimen/navigation_mark_spacing"
		android:importantForAccessibility="no"
		android:src="@drawable/ic_chevron_right"
		android:visibility="gone"
		app:tint="@color/navigation_row_mark" />
</LinearLayout>
