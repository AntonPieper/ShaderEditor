<!-- The passes sheet: no header; its controls, quality, then the passes.
	A standard sheet over the picture, not a modal one: the picture above
	it is what it shows. No id: a screen made again starts with it closed,
	and its behaviour differs by orientation, so none is restored. -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	style="@style/Widget.Material3.BottomSheet"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	app:behavior_hideable="true"
	app:behavior_skipCollapsed="true"
	app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

	<com.google.android.material.bottomsheet.BottomSheetDragHandleView
		android:id="@+id/passes_handle"
		android:layout_width="match_parent"
		android:layout_height="24dp" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:minHeight="48dp"
		android:orientation="horizontal"
		android:paddingStart="4dp"
		android:paddingEnd="@dimen/se_margin_screen">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/passes_pause"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:contentDescription="@string/passes_pause"
			app:icon="@drawable/ic_pause"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/passes_step"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:contentDescription="@string/passes_step"
			app:icon="@drawable/ic_skip_next"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/passes_restart"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:contentDescription="@string/passes_restart"
			app:icon="@drawable/ic_restart_alt"
			app:iconSize="24dp" />

		<Space
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:layout_weight="1" />

		<!-- The most frames a second, kept with the shader. -->
		<com.google.android.material.chip.Chip
			android:id="@+id/passes_limit"
			style="@style/Widget.ShaderEditor.Chip.Limit"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content" />
	</LinearLayout>

	<!-- Seven chips spread over the width, or on two lines when they do
		not fit, as with the largest text. -->
	<com.google.android.material.chip.ChipGroup
		android:id="@+id/passes_quality"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="48dp"
		android:paddingHorizontal="@dimen/se_margin_screen"
		app:chipSpacingVertical="0dp"
		app:selectionRequired="false"
		app:singleSelection="false" />

	<!-- The passes: not shown for a shader of one pass. -->
	<View
		android:id="@+id/passes_divider"
		android:layout_width="match_parent"
		android:layout_height="@dimen/se_hairline"
		android:layout_marginVertical="8dp"
		android:background="?attr/colorOutlineVariant" />

	<androidx.core.widget.NestedScrollView
		android:id="@+id/passes_scroll"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<de.markusfisch.android.shadereditor.widget.PassList
			android:id="@+id/passes_list"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />
	</androidx.core.widget.NestedScrollView>

	<!-- Only while a badge or a dashed line is on screen. -->
	<TextView
		android:id="@+id/passes_key"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:drawablePadding="8dp"
		android:gravity="center_vertical"
		android:minHeight="32dp"
		android:text="@string/passes_key"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?attr/colorOnSurfaceVariant" />

	<Space
		android:layout_width="match_parent"
		android:layout_height="8dp" />
</LinearLayout>
