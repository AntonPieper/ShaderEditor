<!-- A pass in the passes sheet: its picture, its file and, only when it
	says something, a second line; the running mark at the end. The
	picture stays at the top when the row grows. Margins are set by the
	sheet: the picture's left follows the lanes of the rail. -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginEnd="8dp"
	android:background="@drawable/pass_row"
	android:minHeight="56dp"
	android:orientation="horizontal"
	android:paddingHorizontal="8dp"
	android:paddingVertical="6dp">

	<FrameLayout
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginTop="2dp">

		<com.google.android.material.imageview.ShapeableImageView
			android:id="@+id/pass_picture"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_gravity="center"
			android:importantForAccessibility="no"
			android:scaleType="centerCrop"
			app:shapeAppearance="?attr/shapeAppearanceCornerSmall" />
	</FrameLayout>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="16dp"
		android:layout_weight="1"
		android:gravity="center_vertical"
		android:minHeight="44dp"
		android:orientation="vertical">

		<TextView
			android:id="@+id/pass_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="middle"
			android:singleLine="true"
			android:textAppearance="?attr/textAppearanceBodyLarge"
			android:textColor="@color/pass_name" />

		<TextView
			android:id="@+id/pass_line"
			android:drawablePadding="4dp"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFeatureSettings="tnum"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="@color/pass_line"
			android:visibility="gone" />

		<!-- The pass shown grows by what is worth knowing and its actions. -->
		<TextView
			android:id="@+id/pass_facts"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFeatureSettings="tnum"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="@color/pass_line"
			android:visibility="gone" />

		<!-- Chips of what it reads where lines cannot say it. -->
		<LinearLayout
			android:id="@+id/pass_reads"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone" />

		<LinearLayout
			android:id="@+id/pass_actions"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="-12dp"
			android:layout_marginTop="4dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:visibility="gone">

			<Button
				android:id="@+id/pass_open"
				style="?attr/borderlessButtonStyle"
				android:layout_width="wrap_content"
				android:layout_height="40dp"
				android:minWidth="0dp"
				android:text="@string/passes_open"
				android:textColor="?attr/colorOnSecondaryContainer" />

			<Button
				android:id="@+id/pass_size"
				style="?attr/borderlessButtonStyle"
				android:layout_width="wrap_content"
				android:layout_height="40dp"
				android:minWidth="0dp"
				android:text="@string/passes_size_line"
				android:textColor="?attr/colorOnSecondaryContainer" />

			<!-- Only while values leave 0 to 1, or while it is on. -->
			<com.google.android.material.chip.Chip
				android:id="@+id/pass_fit"
				style="@style/Widget.ShaderEditor.Chip.Fit"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:text="@string/passes_fit"
				android:visibility="gone" />
		</LinearLayout>
	</LinearLayout>

	<ImageView
		android:id="@+id/pass_runs"
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:layout_marginTop="10dp"
		android:importantForAccessibility="no"
		android:padding="4dp"
		android:src="@drawable/ic_play_arrow_filled"
		app:tint="?attr/colorPrimary" />
</LinearLayout>
