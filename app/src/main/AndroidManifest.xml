			android:exported="true"
			android:label="Proto ImeRaw5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;copies=1;trace=1;raw=1" />
		</activity-alias>
		<activity-alias
