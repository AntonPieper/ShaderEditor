			android:label="Proto Nodes5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=1;copies=1;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Nodes50k"
			android:exported="true"
			android:label="Proto Nodes50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=1;copies=10;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Nodes500"
			android:exported="true"
			android:label="Proto Nodes500"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=1;copies=0;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.LayoutNodes5k"
			android:exported="true"
			android:label="Proto LayoutNodes5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=layout;nodes=1;copies=1;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.LayoutNodes50k"
			android:exported="true"
			android:label="Proto LayoutNodes50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=layout;nodes=1;copies=10;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeNodes5k"
			android:exported="true"
			android:label="Proto ImeNodes5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=1;copies=1;trace=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeNodes50k"
			android:exported="true"
			android:label="Proto ImeNodes50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=1;copies=10;trace=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeNodesSuggest50k"
			android:exported="true"
			android:label="Proto ImeNodesSuggest50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=1;copies=10;trace=1;suggestions=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeNodesRaw5k"
			android:exported="true"
			android:label="Proto ImeNodesRaw5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=1;copies=1;trace=1;raw=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Stock500"
			android:exported="true"
			android:label="Proto Stock500"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=stock;copies=0;drive=type,big" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Ident500"
			android:exported="true"
			android:label="Proto Ident500"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=2;copies=0;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Ident5k"
			android:exported="true"
			android:label="Proto Ident5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=2;copies=1;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Ident50k"
			android:exported="true"
			android:label="Proto Ident50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=2;copies=10;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.LayoutIdent5k"
			android:exported="true"
			android:label="Proto LayoutIdent5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=layout;nodes=2;copies=1;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeIdent5k"
			android:exported="true"
			android:label="Proto ImeIdent5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=2;copies=1;trace=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeIdent50k"
			android:exported="true"
			android:label="Proto ImeIdent50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;nodes=2;copies=10;trace=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeIdentSuggest50k"
			android:exported="true"
			android:label="Proto ImeIdentSuggest50k"
			android:targetActivity=".editor.proto.ProtoActivity">
