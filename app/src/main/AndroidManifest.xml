<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:installLocation="auto">
	<supports-screens
		android:largeScreens="true"
		android:xlargeScreens="true"/>
	<!-- Camera textures are only supported from API > 14 -->
	<uses-permission android:name="android.permission.CAMERA"/>
	<uses-permission android:name="android.permission.RECORD_AUDIO"/>
	<!-- Required to import textures on API < 19 from gallery apps
		that do not use grantUriPermission(); later API's will not
		see that permission -->
	<uses-permission
		android:name="android.permission.READ_EXTERNAL_STORAGE"
		android:maxSdkVersion="19"/>
	<!-- Required below API < 28 for exporting shaders -->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
		android:maxSdkVersion="28"/>
	<uses-feature android:glEsVersion="0x00020000"/>
	<uses-feature android:name="android.hardware.camera.any"
		android:required="false"/>
	<uses-feature android:name="android.hardware.camera.autofocus"
		android:required="false"/>
	<uses-feature android:name="android.software.live_wallpaper"/>
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW"/>
			<data android:scheme="https"/>
		</intent>
	</queries>
	<application
		tools:ignore="UnusedAttribute"
		android:name=".app.ShaderEditorApp"
		android:allowBackup="true"
		android:fullBackupContent="@xml/backup_rules"
		android:dataExtractionRules="@xml/extraction_rules"
		android:supportsRtl="false"
		android:resizeableActivity="true"
		android:label="@string/app_name"
		android:icon="@mipmap/ic_launcher"
		android:theme="@style/AppTheme">
		<receiver
			android:name=".receiver.BatteryLevelReceiver"
			android:enabled="false"
			android:exported="false"
			android:label="LowBatteryMonitor">
			<intent-filter>
				<action android:name="android.intent.action.BATTERY_LOW"/>
				<action android:name="android.intent.action.BATTERY_OKAY"/>
				<action android:name="android.intent.action.ACTION_BATTERY_CHANGED"/>
			</intent-filter>
		</receiver>
		<service
			android:name=".service.ShaderWallpaperService"
			android:description="@string/wallpaper_description"
			android:label="@string/app_name"
			android:permission="android.permission.BIND_WALLPAPER"
			android:exported="true">
			<intent-filter>
				<action android:name="android.service.wallpaper.WallpaperService"/>
			</intent-filter>
			<meta-data
				android:name="android.service.wallpaper"
				android:resource="@xml/wallpaper"/>
		</service>
		<service android:name="de.markusfisch.android.shadereditor.service.NotificationService"
			android:exported="false"
			android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
			<intent-filter>
				<action android:name="android.service.notification.NotificationListenerService"/>
			</intent-filter>
		</service>

		<provider
			android:name=".provider.UserFilesProvider"
			android:authorities="${applicationId}.documents"
			android:enabled="@bool/project_mode"
			android:exported="true"
			android:grantUriPermissions="true"
			android:permission="android.permission.MANAGE_DOCUMENTS">
			<intent-filter>
				<action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
			</intent-filter>
		</provider>

		<activity
			android:name=".activity.SplashActivity"
			android:theme="@style/SplashTheme"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
		<activity
			android:name=".activity.MainActivity"
			android:launchMode="singleTop"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.VIEW"/>
				<category android:name="android.intent.category.DEFAULT"/>
				<data android:scheme="content"/>
				<data android:host="*"/>
				<data android:mimeType="text/plain"/>
				<data android:mimeType="application/octet-stream"/>
				<data android:mimeType="application/glsl"/>
				<data android:pathPattern=".*\\.glsl"/>
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.VIEW"/>
				<category android:name="android.intent.category.DEFAULT"/>
				<data
					android:scheme="file"
					android:mimeType="*/*"
					android:pathPattern=".*\\.glsl"
					android:host="*"/>
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.SEND"/>
				<category android:name="android.intent.category.DEFAULT"/>
				<data android:mimeType="text/plain"/>
			</intent-filter>
		</activity>
		<activity
			android:name=".activity.PreviewActivity"
			android:label="@string/preview"
			android:theme="@style/PreviewTheme"
			android:launchMode="singleInstance"
			android:documentLaunchMode="intoExisting"
			android:exported="false"/>
		<activity
			android:name=".activity.PreferencesActivity"
			android:label="@string/preferences"
			android:exported="true"/>
		<activity
			android:name=".activity.AddUniformActivity"
			android:label="@string/add_uniform"
			android:exported="false">
			<intent-filter>
				<action android:name="android.intent.action.SEND"/>
				<category android:name="android.intent.category.DEFAULT"/>
				<data android:mimeType="image/*"/>
			</intent-filter>
		</activity>
		<activity
			android:name=".activity.LoadSampleActivity"
			android:label="@string/load_sample"
			android:exported="false"/>
		<activity
			android:name=".activity.TextureViewActivity"
			android:label="@string/view_texture"
			android:exported="false"/>
		<activity
			android:name=".activity.CropImageActivity"
			android:label="@string/crop_image"
			android:exported="false"/>
		<activity
			android:name=".activity.CubeMapActivity"
			android:label="@string/add_uniform"
			android:exported="false"/>
		<!-- THROWAWAY PROTOTYPE (proto/editor-core) -->
		<activity
			android:name=".editor.proto.ProtoActivity"
			android:exported="true"
			android:label="Editor prototype"
			android:theme="@android:style/Theme.Material.NoActionBar"
			android:windowSoftInputMode="adjustResize|stateHidden" />
		<activity-alias
			android:name=".editor.proto.View5k"
			android:exported="true"
			android:label="Proto View5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;copies=1;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.View50k"
			android:exported="true"
			android:label="Proto View50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;copies=10;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Layout5k"
			android:exported="true"
			android:label="Proto Layout5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=layout;copies=1;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Layout50k"
			android:exported="true"
			android:label="Proto Layout50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=layout;copies=10;drive=type,big,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Stock5k"
			android:exported="true"
			android:label="Proto Stock5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=stock;copies=1;drive=type,big" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Stock50k"
			android:exported="true"
			android:label="Proto Stock50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=stock;copies=10;drive=type" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.StockSpans5k"
			android:exported="true"
			android:label="Proto StockSpans5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=stock;copies=1;spans=1;drive=type" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Nested5k"
			android:exported="true"
			android:label="Proto Nested5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=stocknested;copies=1;drive=type,fling" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.NestedSpans5k"
			android:exported="true"
			android:label="Proto NestedSpans5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=stocknested;copies=1;spans=1;drive=type" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Ime5k"
			android:exported="true"
			android:label="Proto Ime5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;copies=1;trace=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.Ime50k"
			android:exported="true"
			android:label="Proto Ime50k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;copies=10;trace=1" />
		</activity-alias>
		<activity-alias
			android:name=".editor.proto.ImeSuggest5k"
			android:exported="true"
			android:label="Proto ImeSuggest5k"
			android:targetActivity=".editor.proto.ProtoActivity">
			<meta-data android:name="args" android:value="mode=view;copies=1;trace=1;suggestions=1" />
		</activity-alias>
		<activity-alias
